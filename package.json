{
  "name": "tiny-modal-dialog",
  "version": "0.1.0",
  "description": "Modal dialog in TypeScript, zero runtime dependencies, no Bootstrap",
  "keywords": [
    "modal",
    "dialog",
    "popup",
    "typescript",
    "vanilla"
  ],
  "author": "Gastón Zalba",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./modal.css": "./dist/modal.css",
    "./modal.min.css": "./dist/modal.min.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run lint && tsup && npm run build:css",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "format": "eslint --fix \"src/**/*.{ts,tsx}\" && prettier --write src",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "bugs": {
    "url": "https://github.com/GastonZalba/tiny-modal-dialog/issues"
  },
  "homepage": "https://github.com/GastonZalba/tiny-modal-dialog#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GastonZalba/tiny-modal-dialog"
  }
}
